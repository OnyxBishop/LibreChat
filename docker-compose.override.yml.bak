services:
  api:
    volumes:
      - ./librechat.yaml:/app/librechat.yaml
      - ./.env:/app/.env

  nginx:
    image: nginx:alpine
    container_name: librechat_nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./client/nginx.conf:/etc/nginx/conf.d/default.conf
      - ./ssl:/etc/nginx/ssl:ro
    depends_on:
      - api
